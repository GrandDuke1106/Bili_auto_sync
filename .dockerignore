# .dockerignore — 减小 Docker 构建上下文，排除运行时才需要的文件
.git
.gitignore
.gitattributes

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# 虚拟环境（不应在构建上下文中）
venv/
.venv/
env/

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 敏感配置 — 运行时通过卷挂载注入
configs/config.yaml
configs/cookies.json

# 运行时数据 — 通过卷挂载，不打包进镜像
data/
logs/

# 媒体文件残留
*.mp4
*.mkv
*.webm
*.srt
*.ass
*.vtt
*.json3
*.jpg
*.jpeg
*.png
*.wav

# Docker 自身
Dockerfile
docker-compose.yml
.dockerignore

# 文档
README.md
LICENSE
*.md
